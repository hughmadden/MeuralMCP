{
  "poll_seconds": 60,
  "reload_after_seconds": 0,
  "service": {
    "root": "/var/lib/meural-api",
    "cert": "/etc/meural-api/chain.pem",
    "key": "/etc/meural-api/key.pem",
    "bind": "0.0.0.0",
    "port": 443
  },
  "devices": [
    {
      "name": "canvas-1",
      "display_name": "Canvas 1",
      "local_ip": "192.0.2.10",
      "product_key": null,
      "orientation": "landscape",
      "enabled": true,
      "schedule": {
        "enabled": false,
        "timezone": "Etc/UTC",
        "sleep_start": "19:30",
        "wake_time": "07:00"
      }
    }
  ]
}
