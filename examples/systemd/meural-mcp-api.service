[Unit]
Description=MeuralMCP REST API
After=network-online.target

[Service]
User=meural-mcp
Group=meural-mcp
Environment=MEURAL_MCP_STORAGE_DIR=/var/lib/meural-mcp
ExecStart=/opt/meural-mcp/.venv/bin/meural-mcp serve --host 127.0.0.1 --port 8733
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
