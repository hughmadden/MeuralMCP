[Unit]
Description=MeuralMCP daemon (sleep schedules)
After=network-online.target

[Service]
User=meural-mcp
Group=meural-mcp
Environment=MEURAL_MCP_STORAGE_DIR=/var/lib/meural-mcp
ExecStart=/opt/meural-mcp/.venv/bin/meural-mcp daemon
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
