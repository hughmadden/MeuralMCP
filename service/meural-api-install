#!/bin/sh
# Install the Meural local API: user, dirs, config and unit. Run as root.
set -eu
HERE=$(cd "$(dirname "$0")" && pwd)

id meural-api >/dev/null 2>&1 || useradd --system --home /var/lib/meural-api \
  --shell /usr/sbin/nologin meural-api

install -d -o root -g root /opt/meural-api /etc/meural-api
install -d -o meural-api -g meural-api /var/lib/meural-api \
  /var/lib/meural-api/media /var/lib/meural-api/by-id \
  /var/lib/meural-api/queues /var/lib/meural-api/status
install -d -o meural-api -g meural-api /var/log/meural-api

install -m 644 "$HERE/meural_api.py" /opt/meural-api/meural_api.py
install -m 644 "$HERE/meural-api.service" /etc/systemd/system/meural-api.service
[ -f /etc/meural-api/meural.conf ] || install -m 640 "$HERE/meural.conf.example" /etc/meural-api/meural.conf
install -m 755 "$HERE/pin-clock.sh" /opt/meural-api/pin-clock.sh 2>/dev/null || true

echo "Place the certificate chain at /etc/meural-api/chain.pem (leaf first)"
echo "and its key at /etc/meural-api/key.pem, mode 600, then:"
echo "  systemctl daemon-reload && systemctl enable --now meural-api"
