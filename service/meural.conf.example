[server]
bind = 0.0.0.0
port = 443
# Certificate chain for api.meural.com, leaf first, then intermediates.
cert = /etc/meural-api/chain.pem
key = /etc/meural-api/key.pem
data = /var/lib/meural-api
gallery_portrait = /var/lib/meural-api/by-id/900002.json
gallery_landscape = /var/lib/meural-api/by-id/900001.json
log = /var/log/meural-api/access.log
